CREATE TABLE Students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    birth_date TEXT,
    email TEXT UNIQUE NOT NULL,
    course_name TEXT NOT NULL,
    enrollment_date TEXT
);

